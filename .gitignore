# dependencies & build output
node_modules/
dist/
coverage/
screens/

# local secrets
.env
.env.*
!.env.example

# your own operating notes for Claude Code (they may import private ones), and your local settings
CLAUDE.local.md
.claude/settings.local.json

# real data and private operations material belong in your data repository, never here
data/
ops/

# work area: uploads and drafts that have not been reviewed and committed yet
.work/

# extraction evaluation: rendered documents (results in eval/results/ are kept)
eval/.out/

# demo datasets (regenerate with `npm run demo:reset` and `npm run demo:sparse`)
demo-data/
demo-sparse/

# an inbox in the code checkout (the data repository holds yours: docs/INGESTION.md)
inbox/

# OS / editor noise
.DS_Store
*.log
*.swp
.idea/
.vscode/*
!.vscode/settings.json
__pycache__/
