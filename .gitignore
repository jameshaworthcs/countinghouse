# dependencies & build output
node_modules/
dist/
coverage/
screens/

# local secrets
.env
.env.*
!.env.example

# your own operating notes for Claude Code (they may import private ones)
CLAUDE.local.md

# work area: uploads and drafts that have not been reviewed and committed yet
.work/

# extraction evaluation: rendered documents (results in eval/results/ are kept)
eval/.out/

# demo datasets (regenerate with `npm run demo:reset` and `npm run demo:sparse`)
demo-data/
demo-sparse/

# inbox: files waiting to be ingested (they move into data/documents once committed)
inbox/*
!inbox/README.md

# OS / editor noise
.DS_Store
*.log
*.swp
.idea/
.vscode/*
!.vscode/settings.json
__pycache__/
