# systemd unit for the finance app. Installed and kept current by scripts/deploy.sh (npm run deploy),
# which fills in @NODE_BIN@, @APP_DIR@ (the live worktree), @USER@, @HOME@ and @DATA_REPO@. See
# docs/SELF_HOSTING.md.
#
# The service runs the code in the live worktree, @APP_DIR@, at the commit last deployed. Its data is
# the data repository's data/ (@DATA_REPO@/data, set in @APP_DIR@/.env), so the app's auto-commits
# land on main there.
[Unit]
Description=Counting House (private personal-finance tracker)
Documentation=file://@APP_DIR@/docs/SELF_HOSTING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP_DIR@
Environment=NODE_ENV=production
Environment=HOME=@HOME@
Environment=PATH=@NODE_BIN@:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
# Serve the API and the UI built by the last deploy on 127.0.0.1:4750 (PORT in @APP_DIR@/.env). A
# plain restart does not rebuild: it restarts the deployed commit exactly as it was.
ExecStart=@NODE_BIN@/node --import tsx src/server/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

# Hardening. Home stays writable because the claude CLI (which reads PDFs and screenshots with your
# Claude login) keeps its credentials and state there; everything else in the OS is read-only.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=@HOME@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
