{
  "$id": "journal.schema.json",
  "title": "journal",
  "description": "Schema for one line of data/journals.jsonl (an entry in a company's books that is not a payment). Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "memo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "lines": {
      "minItems": 2,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ledger": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9-]*(?::[a-z0-9-]+){0,2}$",
            "description": "A ledger code of the chart (src/shared/ledger.ts)"
          },
          "amount": {
            "type": "number",
            "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
          },
          "vat": {
            "type": "object",
            "properties": {
              "treatment": {
                "type": "string",
                "enum": [
                  "standard",
                  "reduced",
                  "zero",
                  "exempt",
                  "outside",
                  "reverse-charge"
                ]
              }
            },
            "required": [
              "treatment"
            ]
          },
          "covers": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "description": "Calendar date, YYYY-MM-DD"
              },
              "to": {
                "type": "string",
                "description": "Calendar date, YYYY-MM-DD"
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
          "asset": {
            "type": "object",
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "computer",
                  "office",
                  "furniture",
                  "motor"
                ]
              },
              "months": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              }
            },
            "required": [
              "class"
            ]
          }
        },
        "required": [
          "ledger",
          "amount"
        ]
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "id": {
      "type": "string",
      "pattern": "^jnl_[0-9a-f]{12}$"
    },
    "companyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable, human-readable identifier (lowercase-hyphenated)"
    },
    "createdBy": {
      "type": "string",
      "enum": [
        "owner",
        "agent"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": [
    "date",
    "memo",
    "lines",
    "id",
    "companyId",
    "createdBy",
    "createdAt",
    "updatedAt"
  ]
}
