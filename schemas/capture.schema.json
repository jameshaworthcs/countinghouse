{
  "$id": "capture.schema.json",
  "title": "capture",
  "description": "Schema for data/capture.json. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable, human-readable identifier (lowercase-hyphenated)"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable, human-readable identifier (lowercase-hyphenated)"
          },
          "institutionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable, human-readable identifier (lowercase-hyphenated)"
          },
          "priority": {
            "default": "normal",
            "type": "string",
            "enum": [
              "high",
              "normal",
              "low"
            ]
          },
          "note": {
            "type": "string"
          },
          "asks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "description": "Stable, human-readable identifier (lowercase-hyphenated)"
                },
                "what": {
                  "type": "string",
                  "minLength": 1
                },
                "how": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "check": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "coverage"
                        },
                        "from": {
                          "type": "string",
                          "description": "Calendar date, YYYY-MM-DD"
                        },
                        "to": {
                          "type": "string",
                          "description": "Calendar date, YYYY-MM-DD"
                        }
                      },
                      "required": [
                        "type",
                        "from"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "valuation"
                        },
                        "since": {
                          "type": "string",
                          "description": "Calendar date, YYYY-MM-DD"
                        },
                        "holdings": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "type",
                        "since"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "figures"
                        },
                        "kinds": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "interest_paid",
                              "interest_tax_deducted",
                              "dividends_paid",
                              "gross_pay",
                              "tax_deducted",
                              "national_insurance",
                              "pension_contribution_employee",
                              "pension_contribution_employer",
                              "pension_tax_relief",
                              "student_loan_deducted",
                              "benefit_in_kind",
                              "gift_aid_donation",
                              "child_benefit",
                              "self_employment_income",
                              "self_employment_expenses",
                              "capital_gain",
                              "capital_loss",
                              "rental_income",
                              "other_income",
                              "earned_pay",
                              "pension_income_forecast",
                              "other"
                            ]
                          }
                        },
                        "taxYear": {
                          "type": "string",
                          "pattern": "^\\d{4}\\/\\d{2}$"
                        },
                        "from": {
                          "type": "string",
                          "enum": [
                            "p60",
                            "payslip"
                          ]
                        },
                        "payer": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "kinds",
                        "taxYear"
                      ]
                    }
                  ]
                },
                "doneAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "ISO 8601 timestamp"
                }
              },
              "required": [
                "id",
                "what"
              ]
            }
          },
          "skippedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "setBy": {
                "type": "string",
                "enum": [
                  "owner",
                  "agent",
                  "system"
                ]
              },
              "model": {
                "type": "string"
              },
              "promptVersion": {
                "type": "string"
              },
              "jobId": {
                "type": "string"
              },
              "session": {
                "type": "string"
              }
            },
            "required": [
              "setBy"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          }
        },
        "required": [
          "id",
          "title",
          "asks",
          "provenance",
          "createdAt",
          "updatedAt"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "items"
  ]
}
