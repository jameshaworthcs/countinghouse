            "description": "Stable, human-readable identifier (lowercase-hyphenated)"
          },
          "kind": {
            "type": "string",
            "enum": [
              "expense",
              "income",
              "transfer",
              "investment"
            ]
          },
          "system": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      }
    },
    "$schema": {
