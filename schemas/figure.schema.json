{
  "$id": "figure.schema.json",
  "title": "figure",
  "description": "Schema for one line of data/figures.jsonl. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fig_[0-9a-f]{16}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "interest_paid",
        "interest_tax_deducted",
        "dividends_paid",
        "gross_pay",
        "tax_deducted",
        "national_insurance",
        "pension_contribution_employee",
        "pension_contribution_employer",
        "pension_tax_relief",
        "student_loan_deducted",
        "benefit_in_kind",
        "gift_aid_donation",
        "child_benefit",
        "self_employment_income",
        "self_employment_expenses",
        "capital_gain",
        "capital_loss",
        "rental_income",
        "other_income",
        "earned_pay",
        "other"
      ]
    },
    "label": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "currency": {
      "default": "GBP",
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "periodStart": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "periodEnd": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "taxYear": {
      "type": "string",
      "pattern": "^\\d{4}\\/\\d{2}$"
    },
    "date": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable, human-readable identifier (lowercase-hyphenated)"
    },
    "payer": {
      "type": "string"
    },
    "payerReference": {
      "type": "string"
    },
    "taxCode": {
      "type": "string",
      "maxLength": 20
    },
    "paidBy": {
      "type": "string",
      "maxLength": 200
    },
    "work": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "maxLength": 120
        },
        "daysWorked": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "holidayDays": {
          "type": "number",
          "minimum": -400,
          "maximum": 400
        },
        "hoursWorked": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "rate": {
          "type": "number",
          "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
        },
        "ratePer": {
          "type": "string",
          "enum": [
            "day",
            "hour"
          ]
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Extra detail from the source with no dedicated field yet (namespaced keys welcome)"
    },
    "source": {
      "default": {},
      "type": "object",
      "properties": {
        "importId": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": [
    "id",
    "kind",
    "label",
    "amount",
    "createdAt"
  ]
}
