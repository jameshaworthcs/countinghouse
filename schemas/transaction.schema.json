{
  "$id": "transaction.schema.json",
  "title": "transaction",
  "description": "Schema for one line of data/transactions/<account>/<year>.jsonl. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tx_[0-9a-f]{16}$"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable, human-readable identifier (lowercase-hyphenated)"
    },
    "date": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "transactionDate": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "time": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
    },
    "transactionTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
    },
    "amount": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "description": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "counterpartyName": {
      "type": "string"
    },
    "merchant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "mcc": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        }
      }
    },
    "bankCategory": {
      "type": "string"
    },
    "cardLast4": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "balanceAfter": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "original": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code"
        }
      },
      "required": [
        "amount",
        "currency"
      ]
    },
    "exchangeRate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fee": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "pending": {
      "type": "boolean"
    },
    "raw": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Extra detail from the source with no dedicated field yet (namespaced keys welcome)"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "date",
              "amount",
              "description"
            ]
          },
          "from": {
            "type": [
              "string",
              "number"
            ]
          },
          "to": {
            "type": [
              "string",
              "number"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "field",
          "from",
          "to",
          "at"
        ]
      }
    },
    "payee": {
      "type": "string"
    },
    "place": {
      "type": "string"
    },
    "payeeSetBy": {
      "type": "string",
      "enum": [
        "user"
      ]
    },
    "category": {
      "type": "string"
    },
    "categorisedBy": {
      "type": "string",
      "enum": [
        "user",
        "rule",
        "builtin",
        "bank",
        "ai",
        "transfer"
      ]
    },
    "ruleId": {
      "type": "string"
    },
    "splits": {
      "minItems": 2,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "amount",
          "category"
        ]
      }
    },
    "transferGroup": {
      "type": "string"
    },
    "counterpartyAccountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable, human-readable identifier (lowercase-hyphenated)"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "default": {},
      "type": "object",
      "properties": {
        "importId": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "seenIn": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "importId": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          },
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          },
          "added": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "transactionDate",
                "transactionTime",
                "time",
                "sourceId",
                "type",
                "reference",
                "counterpartyName",
                "merchant",
                "bankCategory",
                "cardLast4",
                "balanceAfter",
                "original",
                "exchangeRate",
                "fee",
                "attributes"
              ]
            }
          },
          "said": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "required": [
          "at",
          "added"
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": [
    "id",
    "accountId",
    "date",
    "amount",
    "currency",
    "description"
  ]
}
