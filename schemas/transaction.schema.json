            "description": "ISO 8601 timestamp"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "field",
          "from",
          "to",
          "at"
        ]
      }
    },
    "payee": {
      "type": "string"
    },
    "place": {
      "type": "string"
    },
