        "currency"
      ]
    },
    "exchangeRate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fee": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "pending": {
      "type": "boolean"
    },
    "raw": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
