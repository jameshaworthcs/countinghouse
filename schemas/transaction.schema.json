{
  "$id": "transaction.schema.json",
  "title": "transaction",
  "description": "Schema for one line of data/transactions/<account>/<year>.jsonl. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tx_[0-9a-f]{16}$"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable, human-readable identifier (lowercase-hyphenated)"
    },
    "date": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "transactionDate": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "time": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
    },
    "transactionTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
    },
    "amount": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "description": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "counterpartyName": {
      "type": "string"
    },
    "merchant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "mcc": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        }
      }
    },
    "bankCategory": {
      "type": "string"
    },
    "cardLast4": {
      "type": "string",
