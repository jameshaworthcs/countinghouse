{
  "$id": "instruments.schema.json",
  "title": "instruments",
  "description": "Schema for data/instruments.json. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable, human-readable identifier (lowercase-hyphenated)"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "fund",
              "etf",
              "investment_trust",
              "share",
              "bond",
              "gilt",
              "money_market",
              "crypto",
              "other"
            ]
          },
          "isin": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{9}\\d$"
          },
          "ticker": {
            "type": "string",
            "maxLength": 20
          },
          "sedol": {
            "type": "string",
            "pattern": "^[0-9BCDFGHJKLMNPQRSTVWXYZ]{6}\\d$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code"
          },
          "manager": {
            "type": "string"
          },
          "allocation": {
            "type": "object",
            "properties": {
              "equity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bond": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cash": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "property": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "commodity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "crypto": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "other": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "updatedAt"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "instruments"
  ]
}
