{
  "$id": "coverage.schema.json",
  "title": "coverage",
  "description": "Schema for data/coverage.json (stretches you confirmed nothing is missing from). Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cov_[0-9a-f]{12}$"
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable, human-readable identifier (lowercase-hyphenated)"
          },
          "from": {
            "type": "string",
            "description": "Calendar date, YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "Calendar date, YYYY-MM-DD"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "adds-up",
                  "unexplained",
                  "no-balance"
                ]
              },
              "from": {
                "type": "string",
                "description": "Calendar date, YYYY-MM-DD"
              },
              "to": {
                "type": "string",
                "description": "Calendar date, YYYY-MM-DD"
              },
              "through": {
                "type": "string",
                "description": "Calendar date, YYYY-MM-DD"
              },
              "difference": {
                "type": "number",
                "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
              },
              "fromOpening": {
                "type": "boolean"
              }
            },
            "required": [
              "status"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          }
        },
        "required": [
          "id",
          "accountId",
          "from",
          "to",
          "confirmedAt"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "confirmations"
  ]
}
