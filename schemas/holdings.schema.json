{
  "$id": "holdings.schema.json",
  "title": "holdings",
  "description": "Schema for one line of data/holdings/<account>.jsonl. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^hld_[0-9a-f]{16}$"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable, human-readable identifier (lowercase-hyphenated)"
    },
    "date": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "holdings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "isin": {
            "type": "string"
          },
          "ticker": {
            "type": "string"
          },
          "units": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "value": {
            "type": "number",
            "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
          },
          "currency": {
            "default": "GBP",
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code"
          },
          "costBasis": {
            "type": "number",
            "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
          },
          "gain": {
            "type": "number",
            "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
          },
          "assetClass": {
            "type": "string",
            "enum": [
              "equity",
              "bond",
              "mixed",
              "property",
              "cash",
              "commodity",
              "crypto",
              "other"
            ]
          },
          "weight": {
            "type": "number"
          },
          "attributes": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "description": "Extra detail from the source with no dedicated field yet (namespaced keys welcome)"
          }
        },
        "required": [
          "name",
          "value"
        ]
      }
    },
    "cash": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "totalValue": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "source": {
      "default": {},
      "type": "object",
      "properties": {
        "importId": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": [
    "id",
    "accountId",
    "date",
    "holdings",
    "totalValue",
    "createdAt"
  ]
}
