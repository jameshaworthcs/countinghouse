{
  "$id": "receipt.schema.json",
  "title": "receipt",
  "description": "Schema for one line of data/receipts.jsonl. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rct_[0-9a-f]{16}$"
    },
    "transactionId": {
      "type": "string",
      "pattern": "^tx_[0-9a-f]{16}$"
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^doc_[0-9a-f]{16}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fileName": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "path": {
          "type": "string"
        },
        "capturedOn": {
          "type": "string",
          "description": "Calendar date, YYYY-MM-DD"
        },
        "capturedOnSource": {
          "type": "string",
          "enum": [
            "document",
            "exif",
            "filename",
            "file-modified",
            "upload",
            "manual"
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO 8601 timestamp"
        },
        "image": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "device": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "lastModified": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO 8601 timestamp"
        }
      },
      "required": [
        "id",
        "sha256",
        "fileName",
        "mediaType",
        "size"
      ]
    },
    "status": {
      "default": "attached",
      "type": "string",
      "enum": [
        "attached",
        "reading",
        "read",
        "failed"
      ]
    },
    "reading": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO 8601 timestamp"
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "merchant": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "description": "Calendar date, YYYY-MM-DD"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
            },
            {
              "type": "null"
            }
          ]
        },
        "lines": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "amount": {
                "type": "number",
                "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
              },
              "category": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "description",
              "amount"
            ]
          }
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "required": [
        "model",
        "promptVersion",
        "at",
        "lines"
      ]
    },
    "error": {
      "type": "string",
      "maxLength": 500
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": [
    "id",
    "transactionId",
    "document",
    "createdAt",
    "updatedAt"
  ]
}
