{
  "$id": "profile.schema.json",
  "title": "profile",
  "description": "Schema for data/profile.json. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "dateOfBirth": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "taxRegion": {
      "default": "england",
      "type": "string",
      "enum": [
        "england",
        "wales",
        "scotland",
        "northern-ireland"
      ]
    },
    "grossSalary": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "retirementAge": {
      "default": 67,
      "type": "integer",
      "minimum": 50,
      "maximum": 80
    },
    "employers": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "payLagMonths": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "selfAssessment": {
      "type": "object",
      "properties": {
        "sendsReturns": {
          "type": "boolean"
        },
        "years": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\d{4}\\/\\d{2}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "not-needed",
                  "told-hmrc",
                  "registered",
                  "filed",
                  "paid"
                ]
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO 8601 timestamp"
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "status",
              "updatedAt"
            ]
          }
        }
      }
    }
  }
}
