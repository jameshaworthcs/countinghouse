{
  "$id": "profile.schema.json",
  "title": "profile",
  "description": "Schema for data/profile.json. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "dateOfBirth": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "taxRegion": {
      "default": "england",
      "type": "string",
      "enum": [
        "england",
        "wales",
        "scotland",
        "northern-ireland"
      ]
    },
    "grossSalary": {
      "type": "number",
      "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
    },
    "retirementAge": {
      "default": 67,
      "type": "integer",
      "minimum": 50,
      "maximum": 80
    },
    "employers": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "payLagMonths": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "name"
        ]
      }
    }
  }
}
