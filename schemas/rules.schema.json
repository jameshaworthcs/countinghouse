{
  "$id": "rules.schema.json",
  "title": "rules",
  "description": "Schema for data/rules.json. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rule_[0-9a-z]+$"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "priority": {
            "default": 100,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "match": {
            "type": "object",
            "properties": {
              "field": {
                "default": "description",
                "type": "string",
                "enum": [
                  "description",
                  "payee"
                ]
              },
              "op": {
                "default": "contains",
                "type": "string",
                "enum": [
                  "contains",
                  "equals",
                  "startsWith",
                  "endsWith",
                  "regex"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "caseSensitive": {
                "default": false,
                "type": "boolean"
              },
              "accountIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "description": "Stable, human-readable identifier (lowercase-hyphenated)"
                }
              },
              "amountMin": {
                "type": "number",
                "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
              },
              "amountMax": {
                "type": "number",
                "description": "Amount in major units (e.g. pounds), at most 2 dp. Positive increases net worth."
              },
              "direction": {
                "type": "string",
                "enum": [
                  "in",
                  "out"
                ]
              }
            },
            "required": [
              "value"
            ]
          },
          "set": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "payee": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "counterpartyAccountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable, human-readable identifier (lowercase-hyphenated)"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          }
        },
        "required": [
          "id",
          "match",
          "set",
          "createdAt",
          "updatedAt"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "rules"
  ]
}
