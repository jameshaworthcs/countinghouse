{
  "$id": "insight.schema.json",
  "title": "insight",
  "description": "Schema for one line of data/insights.jsonl. Generated from src/shared/schema.ts by `npm run schemas`; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^inf_[0-9a-f]{16}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "month-review",
        "habit",
        "subscription",
        "opportunity",
        "risk",
        "anomaly",
        "fund",
        "allowance",
        "projection",
        "data-quality",
        "note"
      ]
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "overview",
          "accounts",
          "transactions",
          "spending",
          "projections",
          "investments",
          "tax",
          "import"
        ]
      }
    },
    "subject": {
      "default": {},
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable, human-readable identifier (lowercase-hyphenated)"
        },
        "instrumentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable, human-readable identifier (lowercase-hyphenated)"
        },
        "category": {
          "type": "string"
        },
        "taxYear": {
          "type": "string",
          "pattern": "^\\d{4}\\/\\d{2}$"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "body": {
      "type": "string",
      "maxLength": 4000
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "transactions"
              },
              "ids": {
                "minItems": 1,
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^tx_[0-9a-f]{16}$"
                }
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "ids"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "balance"
              },
              "id": {
                "type": "string",
                "pattern": "^bal_[0-9a-f]{16}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "holdings"
              },
              "id": {
                "type": "string",
                "pattern": "^hld_[0-9a-f]{16}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "figure"
              },
              "id": {
                "type": "string",
                "pattern": "^fig_[0-9a-f]{16}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "research"
              },
              "id": {
                "type": "string",
                "pattern": "^res_[0-9a-f]{16}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "assumption"
              },
              "id": {
                "type": "string",
                "pattern": "^asm_[0-9a-f]{16}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "context"
              },
              "id": {
                "type": "string",
                "pattern": "^ctx_[0-9a-f]{16}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "account"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable, human-readable identifier (lowercase-hyphenated)"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "computed"
              },
              "metric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "value": {
                "type": "number"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "metric"
            ]
          }
        ]
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "description": "Calendar date, YYYY-MM-DD"
        },
        "to": {
          "type": "string",
          "description": "Calendar date, YYYY-MM-DD"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "expiresOn": {
      "type": "string",
      "description": "Calendar date, YYYY-MM-DD"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "setBy": {
          "type": "string",
          "enum": [
            "owner",
            "agent",
            "system"
          ]
        },
        "model": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "setBy"
      ]
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "dismissed",
        "superseded"
      ]
    },
    "supersedes": {
      "type": "string"
    },
    "feedback": {
      "type": "object",
      "properties": {
        "useful": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO 8601 timestamp"
        }
      },
      "required": [
        "useful",
        "at"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": [
    "id",
    "kind",
    "pages",
    "title",
    "body",
    "evidence",
    "confidence",
    "provenance",
    "createdAt"
  ]
}
