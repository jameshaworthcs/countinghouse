{
  "name": "countinghouse",
  "version": "0.1.0",
  "private": true,
  "description": "Private, local-first UK personal finance tracker: ingest statements and screenshots into git-versioned structured data.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx scripts/demo-data.ts --if-missing && FINANCE_DATA_DIR=\"${FINANCE_DATA_DIR:-demo-data}\" concurrently -k -n api,web -c blue,magenta \"tsx watch --clear-screen=false src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && NODE_ENV=production tsx src/server/main.ts",
    "serve": "NODE_ENV=production tsx src/server/main.ts",
    "demo": "tsx scripts/demo-data.ts --if-missing && npm run build && FINANCE_DATA_DIR=demo-data PORT=\"${PORT:-4770}\" NODE_ENV=production tsx src/server/main.ts",
    "demo:dev": "npm run dev",
    "deploy": "bash scripts/deploy.sh",
    "demo:reset": "tsx scripts/demo-data.ts --force",
    "demo:sparse": "tsx scripts/demo-data.ts --force --months=1 --dir=demo-sparse",
    "import": "tsx scripts/import.ts",
    "validate": "tsx scripts/validate-data.ts",
    "schemas": "tsx scripts/export-schemas.ts",
    "screens": "tsx scripts/screenshots.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "set-password": "tsx scripts/set-password.ts",
    "ask:eval": "tsx scripts/ask-eval.ts",
    "records": "tsx scripts/records.ts",
    "api": "tsx scripts/api.ts",
    "eval": "tsx eval/run.ts",
    "init-data": "tsx scripts/init-data.ts",
    "fixture:anonymise": "tsx scripts/fixture-anonymise.ts",
    "leak-guard": "node scripts/leak-guard.ts",
    "hooks:install": "node scripts/hooks-install.ts",
    "prepare": "node scripts/hooks-install.ts --quiet"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "exifr": "^7.1.3",
    "hono": "^4.13.10",
    "lucide-react": "^1.48.0",
    "openid-client": "^6.8.8",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jose": "^6.2.12",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
