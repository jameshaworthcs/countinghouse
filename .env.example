# Copy to .env and adjust. Everything here is optional.

# Where the app listens. Keep 127.0.0.1 unless you really mean to expose it.
HOST=127.0.0.1
PORT=4750

# Data directory (default: ./data). The demo uses ./demo-data.
# FINANCE_DATA_DIR=data

# Folder watched for new files to ingest (default: ./inbox). Point it at a Syncthing / cloud-sync folder
# that your phone saves screenshots into and they will be picked up automatically.
# FINANCE_INBOX_DIR=inbox

# Login. Set these with `npm run set-password`, which stores only a scrypt hash. Without a login the
# app answers direct local requests only, and it refuses to listen on a non-loopback HOST.
# FINANCE_USERNAME=
# FINANCE_PASSWORD_HASH=
# FINANCE_SESSION_SECRET=

# Extra Host header values to accept (comma-separated), e.g. a Tailscale MagicDNS name.
# FINANCE_ALLOWED_HOSTS=my-desktop.tailnet-name.ts.net

# Optional: use the Anthropic API for extraction instead of your logged-in `claude` CLI.
# ANTHROPIC_API_KEY=
